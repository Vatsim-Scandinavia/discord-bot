# Set to True in development. It switches logging to console output, disables
# Sentry, and skips the recurring jobs so you can start them manually with the
# slash commands instead.
DEBUG='True'

# Discord
BOT_TOKEN=''
GUILD_ID=0

# Where the bot stores its nickname cache. An empty value is not the same as
# leaving it unset, it resolves to the working directory.
CACHE_DIR='/var/cache/discord-bot'

# VATSIM API
VATSIM_API_TOKEN=''
VATSIM_CHECK_MEMBER_URL='' # To be used with pagination
VATSIM_SUBDIVISION=''
DIVISION_URL=''

# Control Center API
CC_API_URL=''
CC_API_TOKEN=''

# CC role identifiers that map to Discord roles. Comma-separated to map several
# CC roles to one Discord role. Matching is case-insensitive. Defaults shown.
CC_MENTOR_ROLES='mentor'
CC_BUDDY_ROLES='buddy'
CC_TRAINING_ROLES='moderator'

# Event system API
EVENT_CALENDAR_URL=''
EVENT_API_TOKEN=''

# HTTP API that the event system calls to set up and update staffings
FASTAPI_TOKEN='' # Generate a UUID to use as token
FASTAPI_URL='127.0.0.1'
FASTAPI_PORT=80

# Sentry. Only enabled when DEBUG is off.
SENTRY_KEY=''

# Roles
VATSCA_MEMBER_ROLE=0 # The subdivision role this bot manages
VATSIM_MEMBER_ROLE=0 # Set by the VATSIM Community bot, used as a gate
MENTOR_ROLE=0
BUDDY_ROLE=0
TRAINING_STAFF_ROLE=0
VISITOR_ROLE=0
OBS_ROLE=0 # Used to check who may book staffing positions

# Format: country_name_here:role_id_here
# Seperate FIRs with ",".
FIR_DATA=Denmark:0,Finland:0

# Format: country_name_here:role_id_here
# Seperate FIRs with ",".
BUDDY_DATA=Denmark:0,Finland:0

# Format: country_name_here:role_id_here
# Seperate FIRs with ",".
EXAMINER_DATA=Denmark:0,Finland:0

# Format: country_name_here:role_id_here
# Separate FIRs with ",".
CONTROLLER_FIR_DATA=Denmark:0,Finland:0

# Format: country_name_here|rating_name_here:role_id_here
# Separate FIR entries with ",", separate rating and role with "|".
RATING_FIR_DATA=Denmark|S1:0|S2:0,Norway|S3:0|C1:0

# Format: country_name_here|role_name_here:role_id
# Separate entries with ",", separate rating and role pairs with "|".
TRAINING_DATA=Denmark|S2:0,Norway|S1:0,Norway|S2:0

# Format: emoji_name_here|message_id_here|role_id_here
# Separate roles with ",".
# The emoji name must match what the emoji library produces at runtime, and the
# message ID must be a message the bot has posted. See the README.
REACTION_ROLE_DATA=:star:|0|0,:hammer_and_wrench:|0|0

# Channels
EVENTS_CHANNEL=0
RULES_CHANNEL=0
WELCOME_CHANNEL=0
ROLES_CHANNEL=0

# Intervals in seconds. Use a positive value, because 0 makes the loop run
# without pausing.
CHECK_MEMBERS_INTERVAL=86400
STAFFING_INTERVAL=3600 # Drives the recurring slash command sync

# Station prefix. Defaults shown.
STATION_PREFIX_CALLSIGN_SEPARATOR='|'
STATION_PREFIX_SHOW_PILOTS='True'
